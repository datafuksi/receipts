# Copy to .env and fill in. .env is gitignored and dockerignored; never commit it.
ROUTER_BASE_URL=https://router.hostinger.com/v1
ROUTER_API_KEY=
# Pick an ID from GET {ROUTER_BASE_URL}/models
ROUTER_MODEL=
EXA_API_KEY=

# Host port the container is published on (see docker-compose.yml)
HOST_PORT=80

# Abuse limits
RATE_PER_MIN=20
DAILY_CAP=2000
